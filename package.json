{
  "name": "vue-metal-fx",
  "version": "0.1.0",
  "description": "Animated WebGL liquid-metal effect for Vue 3 buttons and UI components. A Vue port of metal-fx.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --config vite.config.demo.ts",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "prepare": "vite build",
    "prepublishOnly": "vite build"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0"
  },
  "keywords": ["vue", "vue3", "webgl", "metal", "shader", "animation", "button", "effect", "glow"],
  "author": "Jackson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Verassitnh/vue-metal-fx.git"
  }
}
